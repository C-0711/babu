<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Homescreen-Name: „babu" bzw. „babu Pro" — unterscheidet die App klar
	     von der Belegwerk-App (io.belegwerk.app), die daneben installiert sein
	     kann. Der Name kommt vom Ziel (BABU_ANZEIGENAME), weil beide Apps aus
	     demselben Ordner entstehen und sich diese Datei teilen. -->
	<key>CFBundleDisplayName</key>
	<string>$(BABU_ANZEIGENAME)</string>
	<!-- Die App spricht nur noch über https://mybabu.io (Store.swift). Die
	     frühere Ausnahme für HTTP im lokalen Netz ist seit 14.09.2026 raus —
	     vor der Einreichung darf sie nicht mehr drinstehen. -->
	<!-- Nur die Verschlüsselung des Systems (HTTPS), keine eigene: damit
	     fragt App Store Connect bei keinem Upload nach der Export-Compliance. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- „Teilen → In babu öffnen": Rechnungen aus Mail, WhatsApp oder
	     Dateien landen direkt im Erfassen-Ablauf. -->
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Beleg</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.adobe.pdf</string>
				<string>public.image</string>
			</array>
		</dict>
	</array>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<!-- Beleg aus der Mediathek hochladen: nur die Bilder, die die Nutzerin
	     selbst auswählt (PhotosPicker). Kein Zugriff auf die ganze Mediathek. -->
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Damit du eine Rechnung, die schon als Foto auf deinem iPhone liegt, als Beleg hochladen kannst. babu sieht nur die Bilder, die du selbst auswählst.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Damit babu ein aufgenommenes Beleg-Foto in deiner Mediathek sichern kann, wenn du das möchtest.</string>
</dict>
</plist>
