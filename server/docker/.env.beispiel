# Vorlage für die `.env` NEBEN compose.yml auf der H200V (~/babu-docker/docker/.env).
# Kopieren, ausfüllen, `chmod 600 .env`, dann `docker compose up -d` — Compose liest
# die Datei von selbst, ein Neustart des Containers reicht (kein Build).
# Die echte `.env` bleibt auf dem Server, nie im Repo (.gitignore).
#
# Mail-Dienst mit SMTP-Relay (Postmark, Brevo, Mailgun …). Solange BABU_SMTP_HOST
# leer ist, geht keine Mail raus: Passwort vergessen bleibt im Portal versteckt,
# Kanzlei-Einladungen landen als Datei unter ~/babu-web/postausgang.
BABU_SMTP_HOST=
BABU_SMTP_PORT=587
BABU_SMTP_NUTZER=
BABU_SMTP_PASSWORT=
# Absender muss zur Domain gehören, für die SPF/DKIM beim Mail-Dienst eingetragen sind.
BABU_ABSENDER=babu <post@babu.0711.io>
# Bekommt eine Kopie jeder Rückmeldung aus der App; leer = keine Kopie.
BABU_SUPPORT_MAIL=

# --- Abo per Stripe (seit 03.10.2026) ---------------------------------------
# Werte aus dem Stripe-Dashboard von 0711 Intelligence. Auf der Dev-Spur
# (~/babu-src/server/docker/.env) die TEST-Werte, auf mybabu.io die LIVE-Werte —
# vertauscht schaltet babu das Abo von selbst ab (Verwechslungsschutz).
# Eingeschränkter Schlüssel (rk_…): Checkout Sessions, Billing Portal,
# Subscriptions, Invoices, Events, Charges, Invoice Payments (lesen/schreiben
# wie nötig). Nie einen Secret Key (sk_…) mit vollen Rechten.
BABU_STRIPE_SCHLUESSEL=
BABU_STRIPE_WEBHOOK_GEHEIMNIS=
BABU_STRIPE_PREIS_SOLO=
BABU_STRIPE_PREIS_SALON=
BABU_STRIPE_PREIS_PLUS=
# Tax Rate „USt 19 %", exklusiv, DE (txr_…)
BABU_STRIPE_STEUERSATZ=
# API-Version des Webhook-Endpunkts im Dashboard, z. B. 2025-09-30.clover
BABU_STRIPE_VERSION=
# Erst auf 1, wenn alles oben gesetzt und die Rechtstexte freigegeben sind.
BABU_ABO=0
# Bekommt „Neues Abo", Zahlungsfehler und den Tagesbericht (leer = BABU_SUPPORT_MAIL).
BABU_BETREIBER_MAIL=

# --- Auszahlung an Ambassadorinnen (seit 03.10.2026) --------------------------
# Aussteller der Gutschriften (Pflichtangaben § 14 UStG). Anschrift mit | trennen.
BABU_FIRMA_NAME=
BABU_FIRMA_ANSCHRIFT=Straße 1|70173 Stuttgart
BABU_FIRMA_USTID=
# Konto von 0711, von dem die Bankdatei (pain.001) abbucht. BIC optional.
BABU_AUSZAHLUNG_NAME=
BABU_AUSZAHLUNG_IBAN=
BABU_AUSZAHLUNG_BIC=
# Wartezeit für junge Provisionen vor dem Stichtag (Tage), z. B. 56 = 8 Wochen
# SEPA-Rückgaberecht. 0 = keine.
BABU_PROVISION_KARENZ_TAGE=0
