# Vorlage für die `.env` NEBEN compose.yml auf der H200V (~/babu-docker/docker/.env).
# Kopieren, ausfüllen, `chmod 600 .env`, dann `docker compose up -d` — Compose liest
# die Datei von selbst, ein Neustart des Containers reicht (kein Build).
# Die echte `.env` bleibt auf dem Server, nie im Repo (.gitignore).
#
# Mail-Dienst mit SMTP-Relay (Postmark, Brevo, Mailgun …). Solange BABU_SMTP_HOST
# leer ist, geht keine Mail raus: Passwort vergessen bleibt im Portal versteckt,
# Kanzlei-Einladungen landen als Datei unter ~/babu-web/postausgang.
BABU_SMTP_HOST=
BABU_SMTP_PORT=587
BABU_SMTP_NUTZER=
BABU_SMTP_PASSWORT=
# Absender muss zur Domain gehören, für die SPF/DKIM beim Mail-Dienst eingetragen sind.
BABU_ABSENDER=babu <post@babu.0711.io>
# Bekommt eine Kopie jeder Rückmeldung aus der App; leer = keine Kopie.
BABU_SUPPORT_MAIL=
